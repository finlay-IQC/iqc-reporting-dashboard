# Copy to .env.local for local dev. In Vercel: Project → Settings → Environment Variables.
# Type in Vercel: NEXT_PUBLIC_* = Config. Everything else = Secret.

# Supabase (Project Settings → Data API / API Keys). EU region (London).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only: lets syncs write data. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Encrypts each client's GHL token before it's stored. Any random string, 32+ characters.
# Keep a copy somewhere safe — if it changes, GHL tokens must be re-entered in Settings.
TOKEN_ENCRYPTION_KEY=

# Meta System User token: ads_read + business_management
# (add leads_retrieval, pages_show_list, pages_read_engagement only if clients run lead form ads)
META_ACCESS_TOKEN=
META_API_VERSION=v24.0

# Lets Vercel Cron run the daily sync. Any random string, 16+ characters.
CRON_SECRET=

# GHL tokens are NOT set here — they're entered per client in the dashboard (Settings → Connect a client).
