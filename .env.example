# Copy to .env.local for local dev. In Vercel, set these under Project → Settings → Environment Variables.

# Supabase (Project Settings → API Keys). Create the project in an EU region (e.g. London).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used by sync jobs to write data. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Meta Marketing API (step 2) — System User token with ads_read + leads_retrieval
META_ACCESS_TOKEN=
META_API_VERSION=v24.0

# GoHighLevel (step 3) — Private Integration tokens, JSON map of locationId → token
GHL_TOKENS={}

# Protects the cron / sync endpoints (Vercel sends this as a Bearer token)
CRON_SECRET=
